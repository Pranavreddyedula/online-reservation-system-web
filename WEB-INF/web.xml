<web-app>

    <servlet>
        <servlet-name>Login</servlet-name>
        <servlet-class>com.reservation.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Login</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Reserve</servlet-name>
        <servlet-class>com.reservation.ReservationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Reserve</servlet-name>
        <url-pattern>/reserve</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Cancel</servlet-name>
        <servlet-class>com.reservation.CancellationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Cancel</servlet-name>
        <url-pattern>/cancel</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
