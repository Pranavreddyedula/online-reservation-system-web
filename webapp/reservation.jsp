<form action="reserve" method="post">
    <input name="name" placeholder="Name" required><br>
    <input name="age" placeholder="Age" required><br>
    <input name="trainNo" placeholder="Train Number" required><br>
    <input name="classType" placeholder="Class Type" required><br>
    <input type="date" name="date" required><br>
    <input name="from" placeholder="From" required><br>
    <input name="to" placeholder="To" required><br><br>
    <button>Reserve</button>
</form>
